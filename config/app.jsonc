                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    // "texture": "monkey",
                    "albedo_map": "monkey",
                    "sampler": "default"
                },
                "concrete": {
                    // "type": "textured",
                    // "shader": "textured",
                    "type": "lited",
                    "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "albedo_map": "concrete_color",
                    "roughness_map": "concrete_rough",
                    // "metallic_map": "concrete_met",
                    // "normal_map": "concrete_nrm",
                    "sampler": "default"
                },
                "floor": {
                    // "type": "textured",
