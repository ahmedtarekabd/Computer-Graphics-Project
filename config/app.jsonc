{
    "start-scene": "menu",
    "window": {
        "title": "Default Game Window",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "lighting": {
            "shader": "lited"
        },
        "assets": {
            "shaders": {
                "lited": {
                    "vs": "assets/shaders/lit.vert",
                    "fs": "assets/shaders/lit.frag"
                },
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "concrete_color": "assets/textures/warehouse/concrete_color.png",
                "concrete_met": "assets/textures/warehouse/concrete_met.png",
                "concrete_nrm": "assets/textures/warehouse/concrete_nrm.png",
                "concrete_rough": "assets/textures/warehouse/concrete_rough.png",
                "floor_color": "assets/textures/warehouse/Floor_Color.png",
                "floor_met": "assets/textures/warehouse/Floor_met.png",
                "floor_nrm": "assets/textures/warehouse/Floor_nrm.png",
                "floor_rough": "assets/textures/warehouse/Floor_rough.png",
                // "gates_color": "assets/textures/warehouse/gates_color.png",
                // "gates_met": "assets/textures/warehouse/gates_met.png",
                // "gates_nrm": "assets/textures/warehouse/gates_nrm.png",
                // "gates_rough": "assets/textures/warehouse/gates_rough.png",
                // "metal_color": "assets/textures/warehouse/Metal_color.png",
                // "metal_met": "assets/textures/warehouse/Metal_met.png",
                // "metal_nrm": "assets/textures/warehouse/Metal_nrm.png",
                // "metal_rough": "assets/textures/warehouse/Metal_rough.png",
                // "roof_color": "assets/textures/warehouse/roof_color.png",
                // "roof_met": "assets/textures/warehouse/roof_met.png",
                // "roof_nrm": "assets/textures/warehouse/roof_nrm.png",
                // "roof_rough": "assets/textures/warehouse/roof_rough.png",
                // "walls_color": "assets/textures/warehouse/walls_color.png",
                // "walls_met": "assets/textures/warehouse/walls_met.png",
                // "walls_nrm": "assets/textures/warehouse/walls_nrm.png",
                // "walls_rough": "assets/textures/warehouse/walls_rough.png",

                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "glass": "assets/textures/glass-panels.png",
                "monkey": "assets/textures/monkey.png",
                "weapon": "assets/textures/Shotgun_HDRP_BaseMap.png",
                "monster": "assets/textures/lava.png",
                "wall": "assets/textures/wall.jpg",
                "asphalt": "assets/textures/black-road-texture.jpg",
                "ghost": "assets/textures/78045.jpg"
            },
            "meshes": {
                "warehouse": "assets/models/warehouse.obj",
                "floor": "assets/models/warehouse/floor.obj",
                // "closed_gates": "assets/models/warehouse/closed_gates.obj",
                // "columns": "assets/models/warehouse/columns.obj",
                // "frames": "assets/models/warehouse/frames.obj",
                // "opened_gates": "assets/models/warehouse/opened_gates.obj",
                // "roof": "assets/models/warehouse/roof.obj",
                // "walls": "assets/models/warehouse/walls.obj",
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",
                "weapon": "assets/models/shotgun2.obj",
                "monster": "assets/models/zombie.obj",
                "ghost": "assets/models/ghost_by_dommk.obj"
            },
            "samplers": {
                "default": {},
                "pixelated": {
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials": {
                "metal": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 0, 0, 1]
                },
                "glass": {
                    "type": "textured",
                    "shader": "textured",
                    // "type": "lited",
                    // "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        },
                        "blending": {
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        },
                        "depthMask": false
                    },
                    "transparent": true,
                    "tint": [1, 1, 1, 1],
                    "texture": "glass",
                    // "albedo_map": "glass",
                    "sampler": "pixelated"
                },
                "grass": {
                    "type": "textured",
                    "shader": "textured",
                    // "type": "lited",
                    // "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass",
                    "sampler": "default"
                },
                "warehouse": {
                    // "type": "textured",
                    // "shader": "textured",
                    "type": "lited",
                    "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    // "texture": "monkey",
                    "albedo_map": "monkey",
                    "sampler": "default"
                },
                "floor": {
                    // "type": "textured",
                    // "shader": "textured",
                    "type": "lited",
                    "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "albedo_map": "floor_color",
                    "roughness_map": "floor_rough",
                    // "metallic_map": "floor_met",
                    // "normal_map": "floor_nrm",
                    "sampler": "default"
                },
                "moon": {
                    "type": "textured",
                    "shader": "textured",
                    // "type": "lited",
                    // "shader": "lited",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "moon",
                    "albedo_map": "moon",
                    "sampler": "default"
                },
                "weapon":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "weapon",
                    "sampler": "default"
                },
                "monster":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "monster",
                    "sampler": "default"
                },
                "wall":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "wall",
                    "sampler": "default"
                },
                "asphalt":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "asphalt",
                    "sampler": "default"
                },"ghost":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "ghost",
                    "sampler": "default"
                }
            }
        },
